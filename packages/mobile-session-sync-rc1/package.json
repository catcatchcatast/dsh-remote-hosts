{
  "name": "dsh-mobile-session-sync-rc1",
  "version": "0.1.0-rc.1",
  "description": "Bounded rc1 mobile Session sync adapter for DSH Host",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
