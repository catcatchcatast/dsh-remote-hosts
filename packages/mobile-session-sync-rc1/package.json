    "@deepseek-ai/dsh-client-connection": "0.1.2-rc.1 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1 || 0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2"
  }
